# sdkconfig.defaults — 需要固化的关键配置
#
# 作用：当 sdkconfig 不存在时（新克隆的仓库、换机器），用这里的值初始化配置。
# 只写"有意选择"的项，其余交给 ESP-IDF 默认值，这样 IDF 升级时能自动跟进新默认值。
#
# 重要：本文件不会覆盖已存在的 sdkconfig。
# 改完这里后必须删除 sdkconfig 再构建（idf.py fullclean 或直接删文件）才会生效。

# ---------- 目标芯片 ----------
# 固定目标，避免新环境忘记执行 idf.py set-target
CONFIG_IDF_TARGET="esp32s3"

# ---------- Flash 与烧录 ----------
# 板上实际为 16MB（N16R8）。这个值会写入镜像头，必须与硬件一致
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"

# ---------- 分区表 ----------
# 使用工程内的 partitions.csv（factory 4MB），取代 IDF 默认的 1MB 单 app 表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- CPU 与内存 ----------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# ---------- 外部 PSRAM ----------
# N16R8 的 8MB PSRAM 走 Octal（8 线）接口，S3 上只有 Octal 模式才认得出 8MB。
# TYPE_AUTO 让 IDF 启动时自动探测容量，不写死型号。
# USE_MALLOC 把 PSRAM 并入默认堆，malloc 在内部 RAM 不够时会自动回落使用它。
# 注意：PSRAM 上的内存不能给 DMA 使用，且访问延迟高于内部 RAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ---------- 控制台与日志 ----------
# UART0 @115200，与 .vscode/settings.json 里的 COM13 监视器一致
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# ---------- FreeRTOS ----------
# tick 100Hz：适合常规任务调度；做高频控制（如电机环）时可提到 1000Hz
CONFIG_FREERTOS_HZ=100

# ---------- 启动与异常 ----------
# app_main 所在任务的栈大小，写外设代码时容易撑爆，注意按需调整
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
# panic 时打印回溯并复位，而不是挂死，便于串口定位
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ---------- 编译 ----------
# 开发期使用 debug 优化级别（-Og），保留完整断言与调试信息。
# 量产时改为 CONFIG_COMPILER_OPTIMIZATION_SIZE=y 或 _PERFORMANCE=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y

# ---------- 板级配置（本工程的硬件接线） ----------
# 这些选项定义在 main/Kconfig.projbuild 里，不写在这里也能编过（Kconfig 有
# default）。写下来是为了让"新克隆的仓库"开箱就是这块板的接线，
# 不用先跑一遍 menuconfig。
#
# 在 menuconfig 里改过的值只会写进 sdkconfig（本机，不入库），
# 所以换板子时记得同步回这一节。
CONFIG_BOARD_LED_GPIO=2
CONFIG_BOARD_LED_ACTIVE_LEVEL=1
CONFIG_BOARD_BUTTON_GPIO=0
CONFIG_BOARD_BUTTON_ACTIVE_LEVEL=0
CONFIG_BOARD_BUTTON_DEBOUNCE_MS=30
CONFIG_BOARD_RGB_GPIO=48
CONFIG_BOARD_RGB_LED_COUNT=1

# DHT11 单总线数据引脚（本板接 GPIO6）。
# 必须外接 5.1kΩ 上拉到 3.3V，传感器用 3.3V 供电，
# 3.3V 时数据线不超过 100cm——理由见 Kconfig 的 help。
CONFIG_BOARD_DHT11_GPIO=6

# 采样周期。DHT11 手册要求大于 2 秒；读太快会静默返回旧值而不是报错。
CONFIG_BOARD_SAMPLE_INTERVAL_MS=2000

# ---------- 设备标识 ----------
# 上报报文里的 device_id，多设备时用来区分数据来源。
# 长度上限 31 字节（sensor_data_t.device_id 是 char[32]）。
# 同一批设备不要重名，否则后端时序数据会混在一起。
CONFIG_DEVICE_ID="esp32s3_001"

# ---------- NTP 时间同步 ----------
# 把设备的开机时钟锚定到绝对时间，报文时间戳才是 Unix 毫秒而不是
# "开机以来的毫秒数"。多设备数据要在同一条时间轴上对齐，必须有这个。
#
# 本工程 CONFIG_LWIP_SNTP_MAX_SERVERS=1，**只能填一台**。
# 留空则不进行同步，报文里的 clock 字段会标成 "boot"（受支持的用法）。
# 换成局域网自建 NTP 也可以，比如路由器地址。
CONFIG_NTP_SERVER="ntp.aliyun.com"
CONFIG_NTP_SYNC_LOG_INTERVAL_S=60

# ---------- MQTT 上报 ----------
# **地址与凭据故意留空**（同 WiFi 凭据的理由：本文件是入库的）。
#
# 留空的效果：不启用 MQTT 上报。设备照常采集、照常往串口打完整报文，
# 只是不发给 broker。填法：idf.py menuconfig → "MQTT broker"
#
# 填的时候**不要用 localhost**——那是 ESP32 自己。要填运行 broker
# 那台机器在局域网里的地址（本机是 192.168.31.128，WSL2 里的 Docker）。
CONFIG_MQTT_BROKER_URI=""
CONFIG_MQTT_USERNAME=""
CONFIG_MQTT_PASSWORD=""
CONFIG_MQTT_CLIENT_ID_PREFIX=""
CONFIG_MQTT_KEEPALIVE_S=60
CONFIG_MQTT_RECONNECT_TIMEOUT_MS=5000
CONFIG_MQTT_NET_TIMEOUT_MS=10000

# ---------- esp-mqtt 组件行为 ----------
# 未连接时**跳过 publish**，而不是把消息塞进内部 outbox。
#
# 为什么必须打开：esp-mqtt 的默认行为是"尽力发送"——未连接时 QoS1/2
# 的消息会进 outbox 排队，publish 返回一个正常的 msg_id（≥0），
# 然后 30 秒后静默过期丢弃。也就是说只看返回值分不出"发出去了"和"丢了"。
#
# 本工程在 mqtt_mgr_publish() 里已经先查连接状态挡住了这种情况，
# 这里是第二道防线：万一将来有人绕过封装直接调 esp_mqtt_client_publish()，
# 打开这个开关会让它**明确返回 -1**，而不是静默丢数据。
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y

# ---------- WiFi 凭据 ----------
# **故意留空**。
#
# 凭据只写进本机 sdkconfig（已被 .gitignore 排除），
# 千万不要把真实密码同步到本文件——本文件是入库的，
# 同步过来就等于把密码提交进了 git。
#
# 填法：idf.py menuconfig → "WiFi 连接（凭据只存本机，不入库）"
# 留空的效果：运行时不联网（main.c 会打一条 warning 说明），
# 但 LED / 按键 / RGB / 温湿度采集与串口上报全部照常。
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""
